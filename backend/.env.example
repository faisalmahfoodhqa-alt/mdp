PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/tawreeed_net

# مع MONGODB_MEMORY_SERVER=1: إصدار ثنائي أخف من 8.x (تنزيل أولي أسرع). اختياري.
# MONGOMS_VERSION=7.0.14
# حزمة أخف أحياناً: MONGOMS_VERSION=6.0.16
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# أصول الواجهات المسموح لها فقط (افصل بينها بفاصلة). في الإنتاج: لا تستخدم *
# الواجهة على نفس جهاز الشبكة: أضِف http://YOUR_LAN_IP:5173 بعد فاصلة
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# أمام nginx / Cloudflare — ضروري لقياس IP الحقيقي مع rate limiting
TRUST_PROXY=0

# حد الطلبات الإجمالي لكل IP كل 15 دقيقة (ما عدا /health)
API_GLOBAL_RATE_MAX=2000

# تقوية bcrypt (10–14)
BCRYPT_ROUNDS=12

# Optional: create super admin on first DB connection if no admin exists
BOOTSTRAP_ADMIN_PHONE=776981756
BOOTSTRAP_ADMIN_PASSWORD=your-secure-password
BOOTSTRAP_ADMIN_NAME=Admin
